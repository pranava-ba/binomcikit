# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Docs
docs/_build/
docs/generated/

# Environments / editors
.venv/
venv/
.env
.idea/
.vscode/
# Ignore local Claude settings, but KEEP project skills tracked & versioned so
# they travel with the repo and load in every session.
.claude/*
!.claude/skills/

# OS
.DS_Store
Thumbs.db

# Dev-only reference material (R source, PDFs) — never part of the package.
reference/
# The copyrighted SoftwareX 2017 source paper (previous-work/) + any generated
# paper.pdf — never commit (copyright + size).
*.pdf
# Lit-review tooling and prior-work notes — side tooling, not part of the package;
# keep them off the main repo entirely (large corpus files, not for pip install).
previous-work/
paper-explorer/

# Never commit secrets
*recovery*codes*.txt
*password*.txt
*API*.txt
*token*.txt
*secret*
*_private_*

